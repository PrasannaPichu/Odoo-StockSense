<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stocksense_delivery_tree" model="ir.ui.view">
        <field name="name">stocksense.delivery.tree</field>
        <field name="model">stocksense.delivery</field>
        <field name="arch" type="xml">
            <tree string="Delivery Orders" decoration-muted="state == 'cancelled'" decoration-success="state == 'validated'">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="warehouse_id"/>
                <field name="location_src_id"/>
                <field name="total_qty" sum="Total Dispatched"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'validated'"
                       decoration-primary="state == 'assigned'"
                       decoration-info="state == 'confirmed'"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="view_stocksense_delivery_form" model="ir.ui.view">
        <field name="name">stocksense.delivery.form</field>
        <field name="model">stocksense.delivery</field>
        <field name="arch" type="xml">
            <form string="Delivery Order">
                <header>
                    <button name="action_open_ocr_intake" string="Upload Document / OCR" type="object"
                            invisible="state == 'validated'" class="btn-info text-white"/>
                    <button name="action_confirm" string="Confirm Order" type="object"
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_pick" string="Pick Items" type="object"
                            invisible="state != 'confirmed'" class="btn-primary"/>
                    <button name="action_pack" string="Pack Order" type="object"
                            invisible="state != 'picked'" class="btn-warning"/>
                    <button name="action_validate" string="Validate &amp; Dispatch" type="object"
                            invisible="state not in ['confirmed', 'picked', 'packed', 'assigned']" class="btn-success"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ['validated', 'cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,picked,packed,validated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Customer &amp; Dispatch">
                            <field name="partner_id" readonly="state == 'validated'"/>
                            <field name="date" readonly="state == 'validated'"/>
                        </group>
                        <group string="Source Location">
                            <field name="warehouse_id" readonly="state == 'validated'"/>
                            <field name="location_src_id" readonly="state == 'validated'"/>
                            <field name="total_qty"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Delivery Line Items" name="lines">
                            <field name="line_ids" readonly="state == 'validated'">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="product_sku"/>
                                    <field name="quantity_requested"/>
                                    <field name="quantity_delivered"/>
                                    <field name="uom_name"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Dispatch Notes" name="notes">
                            <field name="notes" placeholder="Packing instructions, shipping tracking number..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_stocksense_delivery_search" model="ir.ui.view">
        <field name="name">stocksense.delivery.search</field>
        <field name="model">stocksense.delivery</field>
        <field name="arch" type="xml">
            <search string="Search Delivery Orders">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="warehouse_id"/>
                <field name="location_src_id"/>
                <separator/>
                <filter string="Pending Fulfillment (Draft, Confirmed, Assigned)" name="filter_pending" domain="[('state', 'in', ['draft', 'confirmed', 'assigned'])]"/>
                <filter string="Reserved / Picked" name="filter_assigned" domain="[('state', '=', 'assigned')]"/>
                <filter string="Dispatched / Delivered" name="filter_validated" domain="[('state', '=', 'validated')]"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Cancelled" name="filter_cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter string="Customer / Recipient" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Warehouse" name="group_warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter string="Source Location" name="group_location" context="{'group_by': 'location_src_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Dispatch Date" name="group_date" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_stocksense_deliveries" model="ir.actions.act_window">
        <field name="name">Delivery Orders</field>
        <field name="res_model">stocksense.delivery</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_stocksense_delivery_search"/>
        <field name="context">{'search_default_filter_pending': 1}</field>
    </record>

    <menuitem id="menu_stocksense_deliveries_action"
              name="Delivery Orders"
              parent="menu_stocksense_deliveries"
              action="action_stocksense_deliveries"
              sequence="10"/>
</odoo>
