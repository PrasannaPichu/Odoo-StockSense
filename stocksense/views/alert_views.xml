<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stocksense_alert_tree" model="ir.ui.view">
        <field name="name">stocksense.inventory.alert.tree</field>
        <field name="model">stocksense.inventory.alert</field>
        <field name="arch" type="xml">
            <tree string="Inventory Alerts" decoration-danger="severity == 'critical'" decoration-warning="severity == 'warning'">
                <field name="name"/>
                <field name="detected_at"/>
                <field name="product_sku"/>
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <field name="alert_type" widget="badge"/>
                <field name="detection_mechanism" widget="badge"/>
                <field name="current_quantity"/>
                <field name="threshold"/>
                <field name="severity" widget="badge"
                       decoration-danger="severity == 'critical'"
                       decoration-warning="severity == 'warning'"
                       decoration-info="severity == 'info'"/>
                <field name="state" widget="badge"
                       decoration-danger="state == 'new'"
                       decoration-warning="state == 'acknowledged'"
                       decoration-success="state == 'resolved'"/>
            </tree>
        </field>
    </record>

    <record id="view_stocksense_alert_form" model="ir.ui.view">
        <field name="name">stocksense.inventory.alert.form</field>
        <field name="model">stocksense.inventory.alert</field>
        <field name="arch" type="xml">
            <form string="Inventory Alert">
                <header>
                    <button name="action_acknowledge" string="Acknowledge Alert" type="object"
                            invisible="state != 'new'" class="btn-warning"/>
                    <button name="action_resolve" string="Mark as Resolved" type="object"
                            invisible="state == 'resolved'" class="btn-success"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,acknowledged,resolved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h3><field name="alert_type"/></h3>
                    </div>
                    <group>
                        <group string="Affected SKU &amp; Classification">
                            <field name="product_id"/>
                            <field name="product_sku"/>
                            <field name="warehouse_id"/>
                            <field name="detection_mechanism"/>
                            <field name="detected_at"/>
                        </group>
                        <group string="Metrics &amp; Severity">
                            <field name="current_quantity"/>
                            <field name="threshold"/>
                            <field name="severity" widget="badge"
                                   decoration-danger="severity == 'critical'"
                                   decoration-warning="severity == 'warning'"/>
                        </group>
                    </group>
                    <group string="Causal Diagnostic Explanation">
                        <field name="reason"/>
                    </group>
                    <group string="Resolution Audit">
                        <field name="acknowledged_by"/>
                        <field name="resolved_by"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_stocksense_alert_search" model="ir.ui.view">
        <field name="name">stocksense.inventory.alert.search</field>
        <field name="model">stocksense.inventory.alert</field>
        <field name="arch" type="xml">
            <search string="Search Alerts">
                <field name="name"/>
                <field name="product_id"/>
                <field name="product_sku"/>
                <field name="warehouse_id"/>
                <field name="reason"/>
                <separator/>
                <filter string="Active Alerts (New)" name="filter_new" domain="[('state', '=', 'new')]"/>
                <filter string="Acknowledged" name="filter_acknowledged" domain="[('state', '=', 'acknowledged')]"/>
                <filter string="Resolved" name="filter_resolved" domain="[('state', '=', 'resolved')]"/>
                <separator/>
                <filter string="Critical Severity" name="filter_critical" domain="[('severity', '=', 'critical')]"/>
                <filter string="Warning Severity" name="filter_warning" domain="[('severity', '=', 'warning')]"/>
                <separator/>
                <filter string="Anomalies Only" name="filter_anomalies" domain="[('detection_mechanism', 'in', ['deterministic_rule', 'statistical_deviation'])]"/>
                <filter string="Low Stock Breaches" name="filter_low_stock" domain="[('alert_type', '=', 'low_stock')]"/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_alert_type" context="{'group_by': 'alert_type'}"/>
                    <filter string="Detection Mechanism" name="group_mech" context="{'group_by': 'detection_mechanism'}"/>
                    <filter string="Severity" name="group_severity" context="{'group_by': 'severity'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Warehouse" name="group_warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_stocksense_alerts" model="ir.actions.act_window">
        <field name="name">Inventory Alerts &amp; Anomalies</field>
        <field name="res_model">stocksense.inventory.alert</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_stocksense_alert_search"/>
        <field name="context">{'search_default_filter_new': 1}</field>
    </record>

    <menuitem id="menu_stocksense_alerts_action"
              name="Inventory Alerts"
              parent="menu_stocksense_alerts"
              action="action_stocksense_alerts"
              sequence="10"/>
</odoo>
