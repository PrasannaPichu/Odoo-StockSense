<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stocksense_receipt_tree" model="ir.ui.view">
        <field name="name">stocksense.receipt.tree</field>
        <field name="model">stocksense.receipt</field>
        <field name="arch" type="xml">
            <tree string="Goods Receipts" decoration-muted="state == 'cancelled'" decoration-success="state == 'validated'">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="warehouse_id"/>
                <field name="location_dest_id"/>
                <field name="total_qty" sum="Total Received"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'validated'"
                       decoration-info="state == 'confirmed'"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="view_stocksense_receipt_form" model="ir.ui.view">
        <field name="name">stocksense.receipt.form</field>
        <field name="model">stocksense.receipt</field>
        <field name="arch" type="xml">
            <form string="Goods Receipt">
                <header>
                    <button name="action_open_ocr_intake" string="Upload Document / OCR" type="object"
                            invisible="state == 'validated'" class="btn-info text-white"/>
                    <button name="action_confirm" string="Confirm Order" type="object"
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_validate" string="Validate &amp; Increase Stock" type="object"
                            invisible="state not in ['draft', 'confirmed']" class="btn-success"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ['validated', 'cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,validated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Source &amp; Logistics">
                            <field name="partner_id" readonly="state == 'validated'"/>
                            <field name="date" readonly="state == 'validated'"/>
                        </group>
                        <group string="Destination">
                            <field name="warehouse_id" readonly="state == 'validated'"/>
                            <field name="location_dest_id" readonly="state == 'validated'"/>
                            <field name="total_qty"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Product Line Items" name="lines">
                            <field name="line_ids" readonly="state == 'validated'">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="product_sku"/>
                                    <field name="quantity_expected"/>
                                    <field name="quantity_received"/>
                                    <field name="uom_name"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Receiving Notes" name="notes">
                            <field name="notes" placeholder="Delivery vehicle number, seal number, condition notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_stocksense_receipt_search" model="ir.ui.view">
        <field name="name">stocksense.receipt.search</field>
        <field name="model">stocksense.receipt</field>
        <field name="arch" type="xml">
            <search string="Search Goods Receipts">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="warehouse_id"/>
                <field name="location_dest_id"/>
                <separator/>
                <filter string="Pending (Draft &amp; Confirmed)" name="filter_pending" domain="[('state', 'in', ['draft', 'confirmed'])]"/>
                <filter string="Validated" name="filter_validated" domain="[('state', '=', 'validated')]"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Cancelled" name="filter_cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter string="Supplier / Partner" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Warehouse" name="group_warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter string="Destination Location" name="group_location" context="{'group_by': 'location_dest_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Receipt Date" name="group_date" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_stocksense_receipts" model="ir.actions.act_window">
        <field name="name">Goods Receipts</field>
        <field name="res_model">stocksense.receipt</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_stocksense_receipt_search"/>
        <field name="context">{'search_default_filter_pending': 1}</field>
    </record>

    <menuitem id="menu_stocksense_receipts_action"
              name="Goods Receipts"
              parent="menu_stocksense_receipts"
              action="action_stocksense_receipts"
              sequence="10"/>
</odoo>
