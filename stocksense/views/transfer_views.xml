<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stocksense_transfer_tree" model="ir.ui.view">
        <field name="name">stocksense.transfer.tree</field>
        <field name="model">stocksense.transfer</field>
        <field name="arch" type="xml">
            <tree string="Internal Transfers" decoration-muted="state == 'cancelled'" decoration-success="state == 'completed'">
                <field name="name"/>
                <field name="date"/>
                <field name="location_src_id"/>
                <field name="location_dest_id"/>
                <field name="total_qty" sum="Total Relocated"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'completed'"
                       decoration-warning="state == 'in_transit'"
                       decoration-info="state == 'draft'"
                       decoration-danger="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="view_stocksense_transfer_form" model="ir.ui.view">
        <field name="name">stocksense.transfer.form</field>
        <field name="model">stocksense.transfer</field>
        <field name="arch" type="xml">
            <form string="Internal Transfer">
                <header>
                    <button name="action_start_transit" string="Begin Transit / Pick" type="object"
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_complete" string="Complete Transfer &amp; Store" type="object"
                            invisible="state not in ['draft', 'in_transit']" class="btn-success"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ['completed', 'cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_transit,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Source Location">
                            <field name="location_src_id" readonly="state == 'completed'"/>
                            <field name="warehouse_src_id"/>
                            <field name="date" readonly="state == 'completed'"/>
                        </group>
                        <group string="Destination Location">
                            <field name="location_dest_id" readonly="state == 'completed'"/>
                            <field name="warehouse_dest_id"/>
                            <field name="total_qty"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Transfer Line Items" name="lines">
                            <field name="line_ids" readonly="state == 'completed'">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="product_sku"/>
                                    <field name="quantity"/>
                                    <field name="uom_name"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Logistics Notes" name="notes">
                            <field name="notes" placeholder="Forklift operator, transfer reason, pallet IDs..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_stocksense_transfer_search" model="ir.ui.view">
        <field name="name">stocksense.transfer.search</field>
        <field name="model">stocksense.transfer</field>
        <field name="arch" type="xml">
            <search string="Search Internal Transfers">
                <field name="name"/>
                <field name="location_src_id"/>
                <field name="location_dest_id"/>
                <field name="warehouse_src_id"/>
                <field name="warehouse_dest_id"/>
                <separator/>
                <filter string="Active / In Transit" name="filter_in_transit" domain="[('state', '=', 'in_transit')]"/>
                <filter string="Pending (Draft &amp; In Transit)" name="filter_pending" domain="[('state', 'in', ['draft', 'in_transit'])]"/>
                <filter string="Completed &amp; Stored" name="filter_completed" domain="[('state', '=', 'completed')]"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Cancelled" name="filter_cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter string="Source Location" name="group_src_loc" context="{'group_by': 'location_src_id'}"/>
                    <filter string="Destination Location" name="group_dest_loc" context="{'group_by': 'location_dest_id'}"/>
                    <filter string="Origin Warehouse" name="group_src_wh" context="{'group_by': 'warehouse_src_id'}"/>
                    <filter string="Destination Warehouse" name="group_dest_wh" context="{'group_by': 'warehouse_dest_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Transfer Date" name="group_date" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_stocksense_transfers" model="ir.actions.act_window">
        <field name="name">Internal Transfers</field>
        <field name="res_model">stocksense.transfer</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_stocksense_transfer_search"/>
        <field name="context">{'search_default_filter_pending': 1}</field>
    </record>

    <menuitem id="menu_stocksense_transfers_action"
              name="Internal Transfers"
              parent="menu_stocksense_transfers"
              action="action_stocksense_transfers"
              sequence="10"/>
</odoo>
