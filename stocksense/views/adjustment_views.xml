<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stocksense_adjustment_tree" model="ir.ui.view">
        <field name="name">stocksense.adjustment.tree</field>
        <field name="model">stocksense.adjustment</field>
        <field name="arch" type="xml">
            <tree string="Inventory Adjustments" decoration-muted="state == 'cancelled'" decoration-success="state == 'validated'">
                <field name="name"/>
                <field name="date"/>
                <field name="warehouse_id"/>
                <field name="location_id"/>
                <field name="reason" widget="badge"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'validated'"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="view_stocksense_adjustment_form" model="ir.ui.view">
        <field name="name">stocksense.adjustment.form</field>
        <field name="model">stocksense.adjustment</field>
        <field name="arch" type="xml">
            <form string="Inventory Adjustment">
                <header>
                    <button name="action_validate" string="Validate &amp; Adjust Physical Stock" type="object"
                            invisible="state != 'draft'" class="btn-warning"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ['validated', 'cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Audit Parameters">
                            <field name="warehouse_id" readonly="state == 'validated'"/>
                            <field name="location_id" readonly="state == 'validated'"/>
                            <field name="date" readonly="state == 'validated'"/>
                        </group>
                        <group string="Justification">
                            <field name="reason" readonly="state == 'validated'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Count Discrepancies" name="discrepancies">
                            <field name="line_ids" readonly="state == 'validated'">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="product_sku"/>
                                    <field name="recorded_qty"/>
                                    <field name="counted_qty"/>
                                    <field name="discrepancy_qty"
                                           decoration-danger="discrepancy_qty &lt; 0"
                                           decoration-success="discrepancy_qty &gt; 0"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Auditor Remarks" name="remarks">
                            <field name="notes" placeholder="Circumstances of discrepancy, supervisor sign-off..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_stocksense_adjustment_search" model="ir.ui.view">
        <field name="name">stocksense.adjustment.search</field>
        <field name="model">stocksense.adjustment</field>
        <field name="arch" type="xml">
            <search string="Search Inventory Adjustments">
                <field name="name"/>
                <field name="warehouse_id"/>
                <field name="location_id"/>
                <field name="reason"/>
                <field name="notes"/>
                <separator/>
                <filter string="Draft Audits" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Applied to Physical Stock" name="filter_validated" domain="[('state', '=', 'validated')]"/>
                <separator/>
                <filter string="Damaged / Broken" name="filter_damage" domain="[('reason', '=', 'damage')]"/>
                <filter string="Missing / Shrinkage" name="filter_loss" domain="[('reason', '=', 'loss')]"/>
                <filter string="Counting Errors" name="filter_count_error" domain="[('reason', '=', 'count_error')]"/>
                <filter string="Expired" name="filter_expired" domain="[('reason', '=', 'expired')]"/>
                <group expand="0" string="Group By">
                    <filter string="Discrepancy Reason" name="group_reason" context="{'group_by': 'reason'}"/>
                    <filter string="Warehouse" name="group_warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter string="Location" name="group_location" context="{'group_by': 'location_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Audit Date" name="group_date" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_stocksense_adjustments" model="ir.actions.act_window">
        <field name="name">Inventory Adjustments</field>
        <field name="res_model">stocksense.adjustment</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_stocksense_adjustment_search"/>
        <field name="context">{'search_default_filter_draft': 1}</field>
    </record>

    <menuitem id="menu_stocksense_adjustments_action"
              name="Inventory Adjustments"
              parent="menu_stocksense_adjustments"
              action="action_stocksense_adjustments"
              sequence="10"/>
</odoo>
