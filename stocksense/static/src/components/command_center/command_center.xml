<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="stocksense.CommandCenter">
        <div class="stocksense-dashboard">
            <!-- Header -->
            <div class="ss-header">
                <div>
                    <h1>StockSense Command Center</h1>
                    <div class="ss-subtitle">Real-Time Event Streaming &amp; Operational Decision Support</div>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <t t-if="state.metrics.audit_integrity and state.metrics.audit_integrity.valid">
                        <span class="badge bg-success-subtle text-success border border-success p-2">
                            <i class="fa fa-shield me-1"></i> SHA-256 Audit Chain 100% Valid (<t t-esc="state.metrics.audit_integrity.total_blocks"/> Blocks)
                        </span>
                    </t>
                    <t t-else="">
                        <span class="badge bg-danger-subtle text-danger border border-danger p-2">
                            <i class="fa fa-exclamation-triangle me-1"></i> Audit Verification Pending
                        </span>
                    </t>
                    <button class="btn btn-outline-light btn-sm" t-on-click="refreshData">
                        <i class="fa fa-refresh me-1"></i> Refresh Stream
                    </button>
                </div>
            </div>

            <!-- Navigation Tabs -->
            <div class="ss-nav-tabs">
                <button class="ss-tab-btn" t-att-class="{active: state.activeTab === 'overview'}" t-on-click="() =&gt; this.setTab('overview')">
                    <i class="fa fa-th-large me-1"></i> Executive Overview
                </button>
                <button class="ss-tab-btn" t-att-class="{active: state.activeTab === 'flow'}" t-on-click="() =&gt; this.setTab('flow')">
                    <i class="fa fa-sitemap me-1"></i> Warehouse Flow Map
                </button>
                <button class="ss-tab-btn" t-att-class="{active: state.activeTab === 'health'}" t-on-click="() =&gt; this.setTab('health')">
                    <i class="fa fa-heartbeat me-1"></i> Stock Health &amp; Diagnostics
                </button>
                <button class="ss-tab-btn" t-att-class="{active: state.activeTab === 'timeline'}" t-on-click="() =&gt; this.setTab('timeline')">
                    <i class="fa fa-history me-1"></i> Live Event Timeline
                </button>
                <button class="ss-tab-btn" t-att-class="{active: state.activeTab === 'simulator'}" t-on-click="() =&gt; this.setTab('simulator')">
                    <i class="fa fa-sliders me-1"></i> What-If Simulator
                </button>
                <button class="ss-tab-btn" t-att-class="{active: state.activeTab === 'audit'}" t-on-click="() =&gt; this.setTab('audit')">
                    <i class="fa fa-lock me-1"></i> Audit Chain Inspector
                </button>
            </div>

            <!-- TAB 1: EXECUTIVE OVERVIEW -->
            <t t-if="state.activeTab === 'overview'">
                <!-- KPI Cards -->
                <div class="ss-kpi-grid">
                    <div class="ss-kpi-card">
                        <div class="ss-kpi-icon blue"><i class="fa fa-cube"></i></div>
                        <div class="ss-kpi-info">
                            <div class="ss-kpi-label">Active SKUs</div>
                            <div class="ss-kpi-val"><t t-esc="state.metrics.kpis ? state.metrics.kpis.total_products : 0"/></div>
                        </div>
                    </div>
                    <div class="ss-kpi-card">
                        <div class="ss-kpi-icon green"><i class="fa fa-database"></i></div>
                        <div class="ss-kpi-info">
                            <div class="ss-kpi-label">Total Stock Units</div>
                            <div class="ss-kpi-val"><t t-esc="state.metrics.kpis ? state.metrics.kpis.total_stock : 0"/></div>
                        </div>
                    </div>
                    <div class="ss-kpi-card">
                        <div class="ss-kpi-icon red"><i class="fa fa-exclamation-circle"></i></div>
                        <div class="ss-kpi-info">
                            <div class="ss-kpi-label">Critical Stock-Outs</div>
                            <div class="ss-kpi-val"><t t-esc="state.metrics.kpis ? state.metrics.kpis.critical_count : 0"/></div>
                        </div>
                    </div>
                    <div class="ss-kpi-card">
                        <div class="ss-kpi-icon yellow"><i class="fa fa-bell"></i></div>
                        <div class="ss-kpi-info">
                            <div class="ss-kpi-label">Active Alerts</div>
                            <div class="ss-kpi-val"><t t-esc="state.metrics.kpis ? state.metrics.kpis.open_alerts_count : 0"/></div>
                        </div>
                    </div>
                    <div class="ss-kpi-card">
                        <div class="ss-kpi-icon cyan"><i class="fa fa-truck"></i></div>
                        <div class="ss-kpi-info">
                            <div class="ss-kpi-label">Pending Inbound POs</div>
                            <div class="ss-kpi-val"><t t-esc="state.metrics.kpis ? state.metrics.kpis.pending_receipts : 0"/></div>
                        </div>
                    </div>
                    <div class="ss-kpi-card">
                        <div class="ss-kpi-icon blue"><i class="fa fa-paper-plane"></i></div>
                        <div class="ss-kpi-info">
                            <div class="ss-kpi-label">Pending Deliveries</div>
                            <div class="ss-kpi-val"><t t-esc="state.metrics.kpis ? state.metrics.kpis.pending_deliveries : 0"/></div>
                        </div>
                    </div>
                </div>

                <!-- Main Layout -->
                <div class="ss-main-grid">
                    <!-- Left: Warehouse Distribution -->
                    <div class="ss-panel">
                        <div class="ss-panel-header">
                            <h3><i class="fa fa-building me-2"></i>Multi-Warehouse Inventory Distribution</h3>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-dark table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Code</th>
                                        <th>Facility Name</th>
                                        <th>On-Hand Units</th>
                                        <th>Active SKUs</th>
                                        <th>Critical Alerts</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.metrics.warehouse_stats || []" t-as="wh" t-key="wh.id">
                                        <tr>
                                            <td><span class="badge bg-secondary"><t t-esc="wh.code"/></span></td>
                                            <td class="fw-bold"><t t-esc="wh.name"/></td>
                                            <td><t t-esc="wh.total_stock"/></td>
                                            <td><t t-esc="wh.sku_count"/></td>
                                            <td>
                                                <span t-att-class="wh.critical_count &gt; 0 ? 'badge bg-danger' : 'badge bg-success'">
                                                    <t t-esc="wh.critical_count"/> Risks
                                                </span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Right: Critical Attention Items -->
                    <div class="ss-panel">
                        <div class="ss-panel-header">
                            <h3><i class="fa fa-warning text-warning me-2"></i>Priority Operational Focus</h3>
                        </div>
                        <div class="d-flex flex-column gap-3">
                            <t t-foreach="state.metrics.critical_products || []" t-as="cp" t-key="cp.id">
                                <div class="p-3 rounded border border-secondary" style="background: rgba(15,23,42,0.8);">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <div class="fw-bold text-white"><t t-esc="cp.name"/></div>
                                            <small class="text-muted"><t t-esc="cp.sku"/></small>
                                        </div>
                                        <span t-att-class="'ss-badge ' + cp.health_status">
                                            <t t-esc="cp.health_status.toUpperCase()"/> (<t t-esc="cp.health_score"/>%)
                                        </span>
                                    </div>
                                    <div class="mt-2 small text-warning">
                                        Stock: <t t-esc="cp.stock"/> (Safety Min: <t t-esc="cp.min_threshold"/>)
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </t>

            <!-- TAB 2: WAREHOUSE FLOW MAP (SVG) -->
            <t t-if="state.activeTab === 'flow'">
                <div class="ss-panel">
                    <div class="ss-panel-header">
                        <h3><i class="fa fa-sitemap text-primary me-2"></i>Real-Time Warehouse Material Flow Topology</h3>
                        <span class="text-muted small">Live directional movement from Suppliers to Customers</span>
                    </div>
                    <div class="ss-flow-container text-center py-4">
                        <svg class="ss-flow-svg" viewBox="0 0 900 240">
                            <!-- Supplier Node -->
                            <rect x="30" y="80" width="140" height="70" rx="8" fill="#1e293b" stroke="#3b82f6" stroke-width="2"/>
                            <text x="100" y="112" fill="#93c5fd" font-size="14" font-weight="bold" text-anchor="middle">SUPPLIERS</text>
                            <text x="100" y="132" fill="#64748b" font-size="11" text-anchor="middle">Inbound Dock</text>

                            <!-- Inbound Arrow -->
                            <line x1="170" y1="115" x2="260" y2="115" stroke="#3b82f6" stroke-width="2" stroke-dasharray="5,5"/>
                            <polygon points="260,115 250,110 250,120" fill="#3b82f6"/>
                            <text x="215" y="105" fill="#60a5fa" font-size="10" text-anchor="middle">Receipts (+Δ)</text>

                            <!-- Main Warehouse Node -->
                            <rect x="270" y="40" width="220" height="150" rx="10" fill="#1e293b" stroke="#10b981" stroke-width="2"/>
                            <text x="380" y="70" fill="#34d399" font-size="14" font-weight="bold" text-anchor="middle">MAIN DISTRIBUTION (WH-MAIN)</text>
                            <rect x="290" y="85" width="85" height="40" rx="4" fill="#0f172a" stroke="#334155"/>
                            <text x="332" y="110" fill="#cbd5e1" font-size="11" text-anchor="middle">Rack A &amp; B</text>
                            <rect x="385" y="85" width="90" height="40" rx="4" fill="#0f172a" stroke="#334155"/>
                            <text x="430" y="110" fill="#cbd5e1" font-size="11" text-anchor="middle">Production</text>
                            <text x="380" y="165" fill="#10b981" font-size="12" text-anchor="middle">Central Buffer Stock</text>

                            <!-- Inter-Warehouse Transfer Line -->
                            <path d="M 490 90 L 560 90 L 560 60 L 610 60" fill="none" stroke="#6366f1" stroke-width="2" stroke-dasharray="4,4"/>
                            <polygon points="610,60 600,55 600,65" fill="#6366f1"/>
                            <text x="550" y="45" fill="#818cf8" font-size="10" text-anchor="middle">Transfer (Δ=0)</text>

                            <!-- North Hub Node -->
                            <rect x="620" y="30" width="160" height="70" rx="8" fill="#1e293b" stroke="#6366f1" stroke-width="2"/>
                            <text x="700" y="60" fill="#a5b4fc" font-size="13" font-weight="bold" text-anchor="middle">NORTH HUB (WH-NORTH)</text>
                            <text x="700" y="80" fill="#64748b" font-size="11" text-anchor="middle">Regional Depot (Rack C)</text>

                            <!-- Outbound Lines to Customer -->
                            <line x1="490" y1="140" x2="610" y2="170" stroke="#ef4444" stroke-width="2" stroke-dasharray="5,5"/>
                            <polygon points="610,170 600,165 603,175" fill="#ef4444"/>
                            <line x1="700" y1="100" x2="700" y2="135" stroke="#ef4444" stroke-width="2" stroke-dasharray="5,5"/>

                            <!-- Customer Node -->
                            <rect x="620" y="140" width="160" height="70" rx="8" fill="#1e293b" stroke="#ef4444" stroke-width="2"/>
                            <text x="700" y="172" fill="#f87171" font-size="14" font-weight="bold" text-anchor="middle">CUSTOMERS</text>
                            <text x="700" y="192" fill="#64748b" font-size="11" text-anchor="middle">Outbound Fulfillment (-Δ)</text>
                        </svg>
                    </div>
                </div>
            </t>

            <!-- TAB 3: STOCK HEALTH & DIAGNOSTICS -->
            <t t-if="state.activeTab === 'health'">
                <div class="ss-panel">
                    <div class="ss-panel-header">
                        <h3><i class="fa fa-stethoscope text-success me-2"></i>Explainable Inventory Health Diagnostics</h3>
                        <span class="text-muted small">Deterministic Factor Contributions</span>
                    </div>
                    <div class="row g-4">
                        <t t-foreach="state.metrics.critical_products || []" t-as="item" t-key="item.id">
                            <div class="col-md-6">
                                <div class="p-3 rounded border border-secondary" style="background: #0f172a;">
                                    <div class="d-flex justify-content-between">
                                        <h5 class="text-white mb-1"><t t-esc="item.name"/></h5>
                                        <span t-att-class="'ss-badge ' + item.health_status"><t t-esc="item.health_status.toUpperCase()"/></span>
                                    </div>
                                    <div class="text-muted small mb-2">SKU: <t t-esc="item.sku"/> | Current Stock: <t t-esc="item.stock"/> units</div>
                                    <div class="progress mb-3" style="height: 8px;">
                                        <div class="progress-bar bg-warning" role="progressbar" t-att-style="'width: ' + item.health_score + '%'"/>
                                    </div>
                                    <div class="text-white small fw-bold mb-1">Causal Diagnostic Factors:</div>
                                    <div class="text-muted small" style="white-space: pre-line;">
                                        <t t-esc="item.reasons"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </t>

            <!-- TAB 4: LIVE EVENT TIMELINE -->
            <t t-if="state.activeTab === 'timeline'">
                <div class="ss-panel">
                    <div class="ss-panel-header">
                        <h3><i class="fa fa-history text-info me-2"></i>Operational Inventory Event Feed</h3>
                        <span class="text-muted small">Chronological ledger transactions</span>
                    </div>
                    <div class="ss-timeline">
                        <t t-foreach="state.metrics.recent_movements || []" t-as="evt" t-key="evt.id">
                            <div class="ss-timeline-item">
                                <div t-att-class="'ss-timeline-dot ' + evt.op_type"/>
                                <div class="ss-timeline-content">
                                    <div class="ss-timeline-meta">
                                        <span><t t-esc="evt.date"/> · <t t-esc="evt.ref"/></span>
                                        <span class="text-white fw-bold">By: <t t-esc="evt.user"/></span>
                                    </div>
                                    <div class="ss-timeline-title">
                                        <t t-esc="evt.op_type.toUpperCase()"/> — <t t-esc="evt.product_name"/> (<t t-esc="evt.product_sku"/>)
                                    </div>
                                    <div class="small mt-1">
                                        <span t-att-class="evt.delta &gt; 0 ? 'text-success fw-bold' : 'text-danger fw-bold'">
                                            <t t-esc="evt.delta &gt; 0 ? '+' : ''"/><t t-esc="evt.delta"/> Units
                                        </span>
                                        <span class="text-muted ms-2">→ Resulting Balance: <t t-esc="evt.balance_after"/> units</span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </t>

            <!-- TAB 5: WHAT-IF SIMULATOR -->
            <t t-if="state.activeTab === 'simulator'">
                <div class="ss-panel">
                    <div class="ss-panel-header">
                        <h3><i class="fa fa-sliders text-warning me-2"></i>In-Memory What-If Scenario Simulator</h3>
                        <span class="badge bg-info">100% Sandboxed · Zero DB Mutation</span>
                    </div>

                    <div class="ss-sim-box">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="text-muted small fw-bold">Select SKU</label>
                                <select class="form-select bg-dark text-white border-secondary" t-model="state.simProductId">
                                    <t t-foreach="state.metrics.critical_products || []" t-as="p" t-key="p.id">
                                        <option t-att-value="p.id"><t t-esc="p.name"/> (<t t-esc="p.sku"/>)</option>
                                    </t>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="text-muted small fw-bold">Hypothetical Scenario</label>
                                <select class="form-select bg-dark text-white border-secondary" t-model="state.simType">
                                    <option value="delivery">Customer Order Dispatch (Outflow)</option>
                                    <option value="receipt">Supplier Receipt (Inflow)</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="text-muted small fw-bold">Hypothetical Quantity: <span class="text-warning fw-bold"><t t-esc="state.simQty"/></span></label>
                                <input type="range" class="form-range ss-sim-slider" min="5" max="200" step="5" t-model="state.simQty" t-on-input="runSimulator"/>
                            </div>
                        </div>

                        <t t-if="state.simResult">
                            <hr class="border-secondary my-4"/>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="p-3 rounded border border-secondary" style="background: rgba(15,23,42,0.6);">
                                        <div class="text-muted small uppercase">Baseline Actual Stock</div>
                                        <div class="h3 text-white"><t t-esc="state.simResult.current_stock"/> units</div>
                                        <div class="small text-muted">Safety Min: <t t-esc="state.simResult.health_impact.before.factors.stock_ratio_score"/>% buffer</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-3 rounded border border-secondary" style="background: rgba(15,23,42,0.6);">
                                        <div class="text-muted small uppercase">Projected Resulting Stock</div>
                                        <div t-att-class="'h3 ' + (state.simResult.projected_stock &lt; 0 ? 'text-danger' : 'text-success')">
                                            <t t-esc="state.simResult.projected_stock"/> units
                                            <span class="small ms-2">(<t t-esc="state.simResult.stock_delta &gt; 0 ? '+' : ''"/><t t-esc="state.simResult.stock_delta"/>)</span>
                                        </div>
                                        <div class="small text-warning fw-bold"><t t-esc="state.simResult.health_impact.transition"/></div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </t>

            <!-- TAB 6: AUDIT CHAIN INSPECTOR -->
            <t t-if="state.activeTab === 'audit'">
                <div class="ss-panel">
                    <div class="ss-panel-header">
                        <h3><i class="fa fa-lock text-success me-2"></i>Tamper-Evident SHA-256 Hash Chain Integrity</h3>
                    </div>
                    <div class="p-4 rounded border border-success mb-4" style="background: rgba(16,185,129,0.1);">
                        <h4 class="text-success mb-2"><i class="fa fa-check-circle me-2"></i>Forensic Integrity Confirmed</h4>
                        <p class="text-muted mb-0">
                            Every receipt, delivery, transfer, and physical count adjustment is linked via continuous SHA-256 block hashing.
                            Any direct database tampering or raw SQL quantity manipulation invalidates subsequent block hashes immediately.
                        </p>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
